<mxfile host="app.diagrams.net">
  <diagram id="yemscan-usecase" name="YemScan Use Case">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1250" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- System boundary -->
        <mxCell id="sys" value="&lt;b&gt;YemScan Platform&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;verticalAlign=top;align=center;fontSize=16;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="980" height="1110" as="geometry" />
        </mxCell>

        <!-- Actors (Admin on top, User below) -->
        <mxCell id="aAdmin" value="System&lt;br&gt;Administrator" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="70" width="40" height="80" as="geometry" />
        </mxCell>
        <mxCell id="aUser" value="User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="820" width="40" height="80" as="geometry" />
        </mxCell>
        <mxCell id="aTools" value="«system»&lt;br&gt;Scanning Tools&lt;br&gt;(Docker)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1250" y="560" width="40" height="80" as="geometry" />
        </mxCell>
        <mxCell id="aGemini" value="«system»&lt;br&gt;Gemini API" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1250" y="760" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- Admin use cases (top) -->
        <mxCell id="uc19" value="Manage User Accounts" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="60" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc20" value="Manage Platform Settings" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
